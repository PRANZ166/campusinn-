# ══════════════════════════════════════════════════
# Campus Inn+ Backend — Environment Configuration
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL Database
DATABASE_URL=postgresql://campus_inn_user:your_password_here@localhost:5432/campus_inn_db

# JWT Authentication
JWT_SECRET=CHANGE_ME_to_a_random_64_char_string
JWT_EXPIRES_IN=24h

# Frontend Application URL (for OAuth post-login redirect)
FRONTEND_URL=https://campusinn-frontend-9nxrritaj-pranz.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://campus-inn-backend.onrender.com/api/v1/auth/google/callback

# CORS — Frontend origin(s), comma-separated
CORS_ORIGIN=https://campusinn-frontend-9nxrritaj-pranz.vercel.app,http://localhost:3000,http://localhost:5500

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=10

# Session / Cookie
COOKIE_SECRET=CHANGE_ME_to_another_random_string
